{
  "entities": {
    "ResumeProfile": {
      "title": "ResumeProfile",
      "description": "A user-authored structured career resume profile supporting multiple templates and PDF export settings.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the resume owner."
        },
        "title": {
          "type": "string",
          "description": "User-assigned name for this resume version (e.g., Senior Android Engineer CV)."
        },
        "templateId": {
          "type": "string",
          "enum": ["CLASSIC", "MODERN", "TECHNICAL"],
          "description": "Selected resume layout template."
        },
        "accentId": {
          "type": "string",
          "enum": ["INK_NAVY", "TERRACOTTA", "FOREST_SAGE", "CHARCOAL", "BURGUNDY"],
          "description": "Selected accent color palette for preview and PDF export."
        },
        "pageSize": {
          "type": "string",
          "enum": ["A4", "LETTER"],
          "description": "Target PDF page dimensions."
        },
        "showPhotoInPdf": {
          "type": "boolean",
          "description": "Whether to render the locally stored profile photo inside the resume header."
        },
        "fullName": {
          "type": "string",
          "description": "Candidate full name."
        },
        "headline": {
          "type": "string",
          "description": "Target job title or professional headline."
        },
        "email": {
          "type": "string",
          "description": "Contact email address."
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number."
        },
        "location": {
          "type": "string",
          "description": "City and state or country."
        },
        "website": {
          "type": "string",
          "description": "Portfolio or personal website URL."
        },
        "linkedIn": {
          "type": "string",
          "description": "LinkedIn or GitHub profile handle or URL."
        },
        "summary": {
          "type": "string",
          "description": "Professional summary statement."
        },
        "experiences": {
          "type": "array",
          "description": "Ordered list of work experience entries (max 30)."
        },
        "educations": {
          "type": "array",
          "description": "Ordered list of education entries (max 20)."
        },
        "skills": {
          "type": "array",
          "description": "List of skill tags (max 50)."
        },
        "projects": {
          "type": "array",
          "description": "Ordered list of project or certification entries (max 30)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the resume was created (via FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the resume was last updated (via FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "title",
        "templateId",
        "accentId",
        "pageSize",
        "showPhotoInPdf",
        "fullName",
        "headline",
        "email",
        "phone",
        "location",
        "website",
        "linkedIn",
        "summary",
        "experiences",
        "educations",
        "skills",
        "projects",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/resumes/{resumeId}": {
      "schema": { "$ref": "#/entities/ResumeProfile" },
      "description": "User-owned resume documents isolated strictly under the owner's UID."
    }
  }
}
